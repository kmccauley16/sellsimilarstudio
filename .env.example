# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/sell_similar_studio"

# --- App session security ---
# Generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-32-byte-random-secret"

# --- Encryption for stored eBay OAuth tokens (AES-256-GCM key, 32 bytes base64) ---
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY="replace-with-a-32-byte-random-key"

# --- eBay application credentials ---
# Create a keyset at https://developer.ebay.com/my/keys
EBAY_ENVIRONMENT="SANDBOX"
EBAY_CLIENT_ID="replace-with-your-ebay-app-client-id"
EBAY_CLIENT_SECRET="replace-with-your-ebay-app-client-secret"
EBAY_REDIRECT_URI="http://localhost:3000/api/ebay/callback"
# RuName configured in the eBay developer portal for your redirect
EBAY_RU_NAME="replace-with-your-ebay-runame"

# Scopes required for Inventory API drafts + business policies.
EBAY_OAUTH_SCOPES="https://api.ebay.com/oauth/api_scope/sell.inventory https://api.ebay.com/oauth/api_scope/sell.account"

# Marketplace this seller account lists on.
EBAY_MARKETPLACE_ID="EBAY_US"

# Use the real eBay sandbox/production APIs (true) or the in-memory mock adapter (false, default in dev/test).
EBAY_USE_REAL_ADAPTER="false"
