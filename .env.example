# --- Database ---
DATABASE_URL="mysql://user:password@host:3306/sell_similar_studio"

# --- App session security ---
# Generate with: openssl rand -base64 32
JWT_SECRET="replace-with-a-32-byte-random-secret"

# Email address that is granted the "admin" role when it registers.
OWNER_EMAIL="you@example.com"

# --- Photo storage (S3-compatible bucket) ---
S3_BUCKET="replace-with-your-bucket-name"
S3_REGION="us-east-1"
# AWS credentials for the bucket above. The AWS SDK reads these automatically;
# no other code change is needed.
AWS_ACCESS_KEY_ID="replace-with-your-access-key-id"
AWS_SECRET_ACCESS_KEY="replace-with-your-secret-access-key"
# Only set this if using a non-AWS S3-compatible provider (Cloudflare R2, MinIO, etc.)
# S3_ENDPOINT=""

# --- eBay application credentials ---
# Create a keyset at https://developer.ebay.com/my/keys
EBAY_ENVIRONMENT="production"
EBAY_CLIENT_ID="replace-with-your-ebay-app-id"
EBAY_CLIENT_SECRET="replace-with-your-ebay-cert-id"
# RuName from the eBay developer portal's "User Tokens" OAuth redirect config.
EBAY_REDIRECT_URI_NAME="replace-with-your-ebay-runame"
# Generate with: openssl rand -hex 32
EBAY_TOKEN_ENCRYPTION_KEY="replace-with-a-64-char-hex-key"
# Optional: only set this if the public HTTPS endpoint for eBay's Marketplace
# Account Deletion notifications needs to differ from the auto-detected request URL.
# EBAY_DELETION_ENDPOINT=""
